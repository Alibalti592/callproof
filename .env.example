# --- Whop (from https://whop.com/dashboard/developer → your app) ---
WHOP_APP_ID=app_xxxxxxxxxxxxxx
WHOP_API_KEY=

# --- Database ---
# Postgres connection string (Neon, Supabase, Railway). Leave empty for local
# development: an embedded database is created in ./.data
DATABASE_URL=

# --- Prices: bybit (default, falls back to okx) | okx | synthetic ---
PRICE_SOURCE=bybit

# --- Grading ---
# Option A: single always-on server grades by itself every minute
CALLPROOF_INLINE_GRADER=1
# Option B: a scheduler calls /api/cron/grade with this bearer token
CRON_SECRET=

# Public base URL, used in share links and the badge snippet
APP_URL=

# --- Local development only. Never set this in production. ---
# CALLPROOF_DEV_AUTH=1
